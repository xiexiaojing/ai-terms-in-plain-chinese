# 复制成 .env 再填。检索和回答共用一套配置，填一个 key 就能跑。
# 不绑定任何一家：向量化认 OpenAI 兼容协议和 MiniMax 私有协议，回答走标准
# /chat/completions。下面选一家取消注释，或者照着格式填自己的。

LLM_API_KEY=

# ── 端点与模型 ──────────────────────────────────────────────
# 不填就用 MiniMax 的默认值。换别家把这三行都改掉。
# LLM_BASE_URL=https://api.minimaxi.com/v1
# LLM_MODEL=MiniMax-M2.7-highspeed         # 回答用
# EMBEDDING_MODEL=embo-01                  # 向量化用，不填会按端点猜一个

# OpenAI
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini
# EMBEDDING_MODEL=text-embedding-3-small

# 本地 Ollama（完全离线，不花钱，效果看你拉的是什么模型）
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=qwen2.5:7b
# EMBEDDING_MODEL=bge-m3

# 其他家（通义 / 智谱 / 硅基流动 / vLLM 自建…）：
# 只要提供 OpenAI 兼容的 /chat/completions 和 /embeddings 就能接，
# base_url 和模型名去各家文档查，填进上面三行。

# ── 一般不用动 ──────────────────────────────────────────────
# EMBEDDING_PROTOCOL=            # 留空自动探测；也可写死 openai 或 minimax
# EMBEDDING_BATCH=64             # 一次提交多少条，接口报 413 就调小
# LLM_USE_PROXY=1                # 本机 HTTPS_PROXY 指着代理、而接口要走代理时才开

# ⚠️ 换了 EMBEDDING_MODEL 必须重建索引：./refresh.sh
#    维度和向量空间都变了，不重建的话查询跟库里的向量根本不在一个空间，
#    检索会安静地全乱、不报错。服务启动时会核对并提醒。

# ── 想让检索完全离线、一次接口都不调 ──────────────────────────
#   pip install sentence-transformers torch      # 2GB 依赖 + 391MB 权重
#   EMBEDDING_BACKEND=bge ./refresh.sh
# 回答那一步仍然需要一个模型服务，或者干脆不用（只检索不问答）。
